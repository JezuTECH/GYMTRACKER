rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // =========================
    // Helpers
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isSignedIn()
        && ("email" in request.auth.token)
        && request.auth.token.email == "jesusrodriguezsanchez@gmail.com";
    }

    function isAdminApp() {
      return isSignedIn()
        && (
          (("adminApp" in request.auth.token) && request.auth.token.adminApp == true)
          || isAdminEmail()
        );
    }

    function isStrengthWorkout(data) {
      return (!("trackingModeSnapshot" in data) || data.trackingModeSnapshot == "strength")
        && data.weight is number
        && (!("reps" in data) || data.reps == null || data.reps is number)
        && (!("durationMin" in data) || data.durationMin == null)
        && (!("distanceKm" in data) || data.distanceKm == null);
    }

    function isEnduranceWorkout(data) {
      return data.trackingModeSnapshot == "endurance"
        && data.durationMin is number
        && (!("distanceKm" in data) || data.distanceKm == null || data.distanceKm is number)
        && (!("weight" in data) || data.weight == null)
        && (!("reps" in data) || data.reps == null || data.reps is number);
    }

    function isValidWorkoutWrite(data) {
      return data.uid is string
        && data.exercise is string
        && data.muscleGroup is string
        && data.timestamp is timestamp
        && (!("exerciseId" in data) || data.exerciseId == null || data.exerciseId is string)
        && (!("exerciseNameSnapshot" in data) || data.exerciseNameSnapshot == null || data.exerciseNameSnapshot is string)
        && (!("muscleGroupSnapshot" in data) || data.muscleGroupSnapshot == null || data.muscleGroupSnapshot is string)
        && (!("trackingMode" in data) || data.trackingMode == null || data.trackingMode is string)
        && (!("delete" in data) || data.delete is bool)
        && (!("deletedAt" in data) || data.deletedAt == null || data.deletedAt is timestamp)
        && (isStrengthWorkout(data) || isEnduranceWorkout(data));
    }

    // =========================
    // Colección: workouts
    // =========================
    match /workouts/{id} {
      allow read, write: if isAdminApp();

      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && isValidWorkoutWrite(request.resource.data);

      allow update, delete: if isSignedIn()
                            && resource.data.uid == request.auth.uid
                            && request.resource.data.uid == resource.data.uid
                            && isValidWorkoutWrite(request.resource.data);
    }

    // =========================
    // Colección: users
    // =========================
    match /users/{uid} {
      allow read, write: if isAdminApp();

      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      allow update, delete: if isSignedIn()
                            && request.auth.uid == uid
                            && resource.data.uid == uid
                            && request.resource.data.uid == uid;

      // Subcolecciones del usuario
      match /{document=**} {
        allow read, write: if isAdminApp() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // =========================
    // Colección: auditLogs (solo admin)
    // =========================
    match /auditLogs/{id} {
      allow read, write: if isAdminApp();
    }

    // =========================
    // Colección: plans
    // =========================
    match /plans/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.date is timestamp
                    && request.resource.data.description is string
                    && request.resource.data.routines is list;

      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.date is timestamp
                    && request.resource.data.description is string
                    && request.resource.data.routines is list;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // =========================
    // Regla por defecto: denegar todo
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
